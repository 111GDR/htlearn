PORT=5000
MONGO_URI=mongodb://localhost:27017/elearning
JWT_SECRET=change-me-in-production
CLIENT_URL=http://localhost:5173
# Public URL of the frontend — used inside transactional emails (welcome, reset).
APP_URL=http://localhost:5173

# SMTP for transactional emails (welcome / password reset).
# If any of these are missing, emails are logged to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "true" forces TLS; leave empty and the server picks based on port (465 = secure).
SMTP_SECURE=
SMTP_FROM=HtLearn <no-reply@htlearn.local>

# Cloudflare R2 (optional — falls back to local /uploads if any are missing)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Groq (used by /api/quizzes/generate). Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the model used for quiz generation.
#   llama-3.1-8b-instant   -> 14,400 RPD (default, fast)
#   llama-3.3-70b-versatile -> 1,000 RPD (smarter, slower)
GROQ_MODEL=
# Optional: model used for the per-lesson AI tutor. Defaults to 70B for richer answers.
GROQ_TUTOR_MODEL=
